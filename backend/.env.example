# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# En local : variables séparées.
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=softtransit
# En production (Render) : une seule variable fournie automatiquement par le
# service PostgreSQL Render (voir render.yaml). Ne pas la définir en local.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── Chiffrement des documents (AES-256-GCM) ─────────────────────────────────
# 32 octets en hexadécimal (64 caractères) — ex : openssl rand -hex 32
DOCUMENT_ENCRYPTION_KEY=your_64_char_hex_key_here

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# ─── URL du frontend (liens email, CORS) ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Stockage fichiers ────────────────────────────────────────────────────────
# Si les 3 variables CLOUDFLARE_R2_* ci-dessous sont absentes : stockage sur
# disque local (backend/uploads). Si présentes : stockage sur Cloudflare R2.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=softtransitgabon-documents
